# Copie para .env. O .env não é versionado.

# Segredo dos tokens da API (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Senha do PostgreSQL local (padrão: clinix).
# POSTGRES_PASSWORD=clinix

# Portas no seu computador (padrões entre parênteses).
# PORTA_WEB=8800
# PORTA_API=8801
# PORTA_GRAFANA=3300
# PORTA_PROMETHEUS=9095

# Onde estão os outros repositórios (padrão: ao lado deste).
# CAMINHO_BACKEND=../clinix-backend
# CAMINHO_FRONTEND=../clinix-frontend/clinix
